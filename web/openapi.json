{
  "openapi": "3.1.0",
  "info": {
    "title": "Basis Lab API",
    "version": "0.1.0",
    "description": "Normalized OHLC and cross-venue premium/discount candles. All timestamps are Unix milliseconds and no authentication is required."
  },
  "servers": [{ "url": "/", "description": "Current deployment" }],
  "paths": {
    "/api/v1/health": {
      "get": { "operationId": "health", "summary": "Service health", "responses": { "200": { "description": "Healthy" } } }
    },
    "/api/v1/venues": {
      "get": { "operationId": "listVenues", "summary": "List venue adapters and supported intervals", "responses": { "200": { "description": "Venue list" } } }
    },
    "/api/v1/markets": {
      "get": {
        "operationId": "listMarkets",
        "summary": "Discover active markets on a venue",
        "parameters": [
          { "$ref": "#/components/parameters/Venue" },
          { "name": "query", "in": "query", "schema": { "type": "string", "default": "" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 } }
        ],
        "responses": { "200": { "description": "Active markets" }, "502": { "$ref": "#/components/responses/UpstreamError" } }
      }
    },
    "/api/v1/candles": {
      "get": {
        "operationId": "getCandles",
        "summary": "Get normalized OHLC candles",
        "parameters": [
          { "$ref": "#/components/parameters/Venue" },
          { "$ref": "#/components/parameters/Market" },
          { "$ref": "#/components/parameters/Interval" },
          { "$ref": "#/components/parameters/From" },
          { "$ref": "#/components/parameters/To" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": { "200": { "description": "Normalized candles" }, "400": { "$ref": "#/components/responses/BadRequest" }, "502": { "$ref": "#/components/responses/UpstreamError" } }
      }
    },
    "/api/v1/compare": {
      "get": {
        "operationId": "compareMarkets",
        "summary": "Calculate premium/discount candles for two markets",
        "description": "Calculates (left / right - 1) × scale. Open and close use like-for-like fields. High uses left.high/right.low and low uses left.low/right.high, a conservative envelope because OHLC data cannot prove simultaneous extremes.",
        "parameters": [
          { "name": "left_venue", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Venue" } },
          { "name": "left_market", "in": "query", "required": true, "schema": { "type": "string", "example": "WLFIUSDT" } },
          { "name": "right_venue", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Venue" } },
          { "name": "right_market", "in": "query", "required": true, "schema": { "type": "string", "example": "WLFI_USDT" } },
          { "$ref": "#/components/parameters/Interval" },
          { "$ref": "#/components/parameters/From" },
          { "$ref": "#/components/parameters/To" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "scale", "in": "query", "schema": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000, "default": 10000 } }
        ],
        "responses": { "200": { "description": "Comparison candles and summary statistics" }, "400": { "$ref": "#/components/responses/BadRequest" }, "422": { "description": "No timestamp overlap" }, "502": { "$ref": "#/components/responses/UpstreamError" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Venue": {
        "type": "string",
        "enum": ["binance_spot", "binance_perp", "bybit_spot", "bybit_perp", "hyperliquid_perp", "lighter_perp", "aster_perp", "ondo_perp", "mexc_spot", "mexc_perp", "okx_spot", "okx_perp"]
      }
    },
    "parameters": {
      "Venue": { "name": "venue", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Venue" } },
      "Market": { "name": "market", "in": "query", "required": true, "schema": { "type": "string", "example": "BTCUSDT" } },
      "Interval": { "name": "interval", "in": "query", "required": true, "schema": { "type": "string", "enum": ["1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "1d"], "default": "1h" } },
      "From": { "name": "from", "in": "query", "required": true, "description": "Unix milliseconds", "schema": { "type": "integer", "format": "int64" } },
      "To": { "name": "to", "in": "query", "required": true, "description": "Unix milliseconds", "schema": { "type": "integer", "format": "int64" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1500, "default": 1000 } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid parameters" },
      "UpstreamError": { "description": "The venue rejected or failed the request" }
    }
  }
}

